root = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = off
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable
ij_kotlin_packages_to_use_import_on_demand = androidx.compose.foundation.layout.*,androidx.compose.material3.*,androidx.compose.runtime.*,androidx.navigation.compose.*,com.adulthub.tv.data.model.*,com.adulthub.tv.ui.auth.*,com.adulthub.tv.ui.library.*

